# ============ LLM（OpenAI 兼容端点，DeepSeek / 通义 / vLLM 同理） ============
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.3
MAX_TOKENS=2048

# ============ Agent ============
# 单次对话最多允许多少个图步骤（防止工具循环停不下来）
RECURSION_LIMIT=30

# ============ RAG ============
# auto: 有 key 用 OpenAI embedding，失败自动降级为本地 BM25 词法检索
# openai | none
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MIN_SCORE=0.08
# 是否把命中的知识库片段自动注入 system prompt
RAG_AUTO_INJECT=true

# ============ MCP ============
MCP_ENABLED=true
MCP_LOAD_TIMEOUT=90000

# ============ Web ============
PORT=3000
